DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Use your current forwarded HTTPS URL in Codespaces or your canonical HTTPS site URL in production.
BETTER_AUTH_URL=https://your-app.example.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-restricted-google-maps-api-key

# The header your trusted deployment proxy overwrites with the client IP.
AUTH_CLIENT_IP_HEADER=x-forwarded-for

# SMTP credentials for verification and password-reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=SoilMeter M1 <no-reply@example.com>
